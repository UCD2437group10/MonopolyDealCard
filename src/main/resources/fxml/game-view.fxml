<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.group10.FrontEnd.controller.GameController"
            prefHeight="720.0" prefWidth="1280.0"
            style="-fx-font-family: 'Segoe UI', sans-serif;">

    <top>
        <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10px; -fx-background-color: #1b4332; -fx-border-color: #081c15; -fx-border-width: 0 0 2px 0;">
            <Label fx:id="phaseLabel" text="Phase: Waiting..." style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Label fx:id="currentPlayerLabel" text="Current turn: None" style="-fx-font-size: 18px; -fx-text-fill: #ffd166; -fx-font-weight: bold;"/>
            <Label fx:id="winnerLabel" text="" style="-fx-font-size: 18px; -fx-text-fill: #ef476f; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <left>
        <VBox fx:id="playersArea" prefWidth="250" style="-fx-background-color: #2d6a4f; -fx-padding: 15px; -fx-border-color: #1b4332; -fx-border-width: 0 2px 0 0;">
            <Label text="Other Players" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: #40916c;">
            <Label text="Center Board (Draw Pile / Discard Pile)" style="-fx-font-size: 24px; -fx-text-fill: rgba(255,255,255,0.6); -fx-font-weight: bold;"/>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="15" style="-fx-background-color: #2d6a4f; -fx-padding: 15px; -fx-border-color: #1b4332; -fx-border-width: 2px 0 0 0;">

            <HBox spacing="20">
                <VBox fx:id="moneyArea" prefWidth="300" prefHeight="140" style="-fx-border-color: #74c69d; -fx-border-width: 2px; -fx-border-radius: 5px; -fx-padding: 8px; -fx-background-color: rgba(0,0,0,0.15);">
                    <Label text="Bank Area" style="-fx-text-fill: #74c69d; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </VBox>
                <VBox fx:id="propertyArea" prefWidth="800" prefHeight="140" style="-fx-border-color: #74c69d; -fx-border-width: 2px; -fx-border-radius: 5px; -fx-padding: 8px; -fx-background-color: rgba(0,0,0,0.15);" HBox.hgrow="ALWAYS">
                    <Label text="Property Area" style="-fx-text-fill: #74c69d; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </VBox>
            </HBox>

            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="My Hand:" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <VBox fx:id="handArea" spacing="10" HBox.hgrow="ALWAYS" style="-fx-border-color: #ffd166; -fx-border-width: 2px; -fx-border-radius: 5px; -fx-padding: 8px; -fx-min-height: 140px; -fx-background-color: rgba(0,0,0,0.15);">
                </VBox>

                <VBox spacing="15" alignment="CENTER">
                    <Button fx:id="drawCardButton" text="Draw Card" prefWidth="120" prefHeight="40" style="-fx-background-color: #ffd166; -fx-text-fill: #1b4332; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;"/>
                    <Button fx:id="endTurnButton" text="End Turn" prefWidth="120" prefHeight="40" style="-fx-background-color: #ef476f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;"/>
                </VBox>
            </HBox>

        </VBox>
    </bottom>

</BorderPane>
@startuml
' One full turn flow aligned with Class/UseCase
actor Player as P
participant TurnSimulator as TS
participant MainView as UI
participant ApiClient as API
participant GameHttpServer as Server
participant GameApiHandler as Handler
participant GameController as GC
participant Game as G

TS -> UI: simulateOneTurn(playerId)
activate TS

' 1) Start turn: draw 2 cards (mandatory)
TS -> UI: startTurn(playerId)
P -> UI: Click [Start Turn]
UI -> API: drawCard(playerId) x2
API -> Server: POST /api/drawCard (x2)
Server -> Handler: drawCard(reqJson)
Handler -> GC: handleDraw(playerId)
GC -> G: draw(2) + update hand
G --> GC: updatedState
GC --> Handler: resultJson(success)
Handler --> Server: HTTP 200 + resultJson
Server --> API: HTTP 200 + resultJson
API --> UI: Refresh hand cards

' 2) Main action: play cards (0..3)
loop up to 3 plays in current turn
  P -> UI: Select card and click [Play]
  UI -> API: playCard(playerId, cardId)
  API -> Server: POST /api/playCard
  Server -> Handler: playCard(reqJson)
  Handler -> GC: handlePlayCard(playerId, cardId)
  GC -> G: validate and apply card

  alt play accepted
    G --> GC: success + updatedState
    GC --> Handler: resultJson(success)
    Handler --> Server: HTTP 200 + resultJson
    Server --> API: HTTP 200 + resultJson
    API --> UI: refresh board/hand
  else play rejected
    G --> GC: failed + reason
    GC --> Handler: resultJson(failed, reason)
    Handler --> Server: HTTP 400 + resultJson
    Server --> API: HTTP 400 + resultJson
    API --> UI: show [Play Failed] + reason
  end
end

' 3) End phase: discard to hand limit if needed
alt handCards > 7
  P -> UI: Select cards to discard
  UI -> API: discardCards(playerId, cardIds)
  API -> Server: POST /api/discard
  Server -> Handler: discardCards(reqJson)
  Handler -> GC: handleDiscard(playerId, cardIds)
  GC -> G: move cards hand -> discard pile
  G --> GC: updatedState
  GC --> Handler: resultJson(success)
  Handler --> Server: HTTP 200 + resultJson
  Server --> API: HTTP 200 + resultJson
  API --> UI: refresh hand cards
end

' 4) End turn
TS -> UI: endTurn(playerId)
P -> UI: Click [End Turn]
UI -> API: endTurn(playerId)
API -> Server: POST /api/endTurn
Server -> Handler: endTurn(reqJson)
Handler -> GC: handleEndTurn(playerId)
GC -> G: nextTurn()
G --> GC: state for next player
GC --> Handler: stateJson
Handler --> Server: HTTP 200 + stateJson
Server --> API: HTTP 200 + stateJson
API --> UI: show next player's turn

UI --> TS: oneTurnResult(success/fail, latestState)
deactivate TS

@enduml

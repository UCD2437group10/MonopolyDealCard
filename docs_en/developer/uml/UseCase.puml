@startuml
title Monopoly Deal - Use Case

actor "Player" as User
actor "TurnSimulator" as TS

rectangle "Frontend (MainView + ApiClient)" {
    usecase "simulate one turn" as UC0
    usecase "start turn (draw 2 cards)" as UC1
    usecase "play cards (0..3 actions)" as UC2
    usecase "discard to hand limit (<=7)" as UC3
    usecase "end turn" as UC4

    usecase "pay rent / debt" as UC5
    usecase "trade or steal property" as UC6
    usecase "block action (Just Say No)" as UC7
    usecase "play failed" as UC8
}

TS --> UC0
User --> UC1
User --> UC2
User --> UC3
User --> UC4

UC0 ..> UC1 : <<include>>
UC0 ..> UC2 : <<include>>
UC0 ..> UC3 : <<include>>
UC0 ..> UC4 : <<include>>

UC2 ..> UC5 : <<extend>>
UC2 ..> UC6 : <<extend>>
UC2 ..> UC7 : <<extend>>
UC2 ..> UC8 : <<extend>>

@enduml
